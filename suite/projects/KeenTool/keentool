    IFS='|' read -r N P R F <<EOF
$T_DEF
EOF
    while true; do
        header
        if [ -f "$P" ]; then VER=$(get_version "$P"); echo -e "$N Status: ${GREEN}Installed (v$VER)${RESET}"; else echo -e "$N Status: ${DIM}Not Installed${RESET}"; fi
        echo ""; echo " 1. Install / Update"; echo " 2. Manage Cron"; echo " 3. Uninstall";
        if [ "$RUN_OPT" = "yes" ]; then echo " 4. Run Tool (Interactive)"; fi
        echo ""; echo " 0. Back"; echo "";
        echo -n "Select: "; read -r op
        case $op in
            1) header; if [ "$N" = "SMB Backup" ]; then check_and_install_deps "$DEPS_SMB"; fi
               if [ "$N" = "Traffic Manager" ]; then check_and_install_deps "$DEPS_VNSTAT"; fi
               if [ "$N" = "Main Dashboard" ]; then 
                   check_and_install_deps "$DEPS_DASH"
                   smart_process "$N" "$P" "$R" "$F"; sanitize_and_reload_cron; 
                   configure_dashboard_extras "silent"
               else
                   smart_process "$N" "$P" "$R" "$F"; sanitize_and_reload_cron
               fi
               
               if [ -n "$T_CMD" ]; then manage_cron_menu "$T_CMD"; fi; pause ;;
            2) if [ -n "$T_CMD" ]; then manage_cron_menu "$T_CMD"; else echo "No cron job defined."; pause; fi; ;;
            3) header; echo -e "${BOLD}Uninstall $N${RESET}"; echo -n " -> Remove file and cron? (y/n): "; read -r ans
               if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then
                   if [ -f "$P" ]; then rm -f "$P"; echo -e "    File removed."; else echo -e "    File not found."; fi
                   if [ -n "$T_CMD" ]; then remove_cron_cmd "$T_CMD"; fi
                   echo -e "${GREEN}Done.${RESET}"
               fi; pause ;;
            4) if [ "$RUN_OPT" = "yes" ]; then
                   if [ -x "$P" ]; then
                       header
                       run_protected "$P"
                       pause
                   else
           
                       echo -e "${RED}Tool not found or not executable.${RESET}"
                       pause
                   fi
               fi ;;
            0) return ;;
        esac
    done
}

check_firewall_mods() {
    echo -n "    Checking Kernel Modules... "
    MISSING=""

    # 1. FILE-BASED CHECK (Standard Modules)
    # Check for modules that typically exist as .ko files or are listed in modules.builtin
    FILE_MODS="xt_recent xt_multiport xt_NFLOG nfnetlink_log"

    # Determine module path
    KVER="4.9-ndm-5"
    if [ -d "/lib/modules/$(uname -r)" ]; then KVER="$(uname -r)"; fi
    MOD_DIR="/lib/modules/$KVER"

    for M in $FILE_MODS; do
        # Check if .ko file exists OR if it is listed in modules.builtin
        if [ ! -f "$MOD_DIR/${M}.ko" ] && ! grep -q "$M" "$MOD_DIR/modules.builtin" 2>/dev/null; then
            MISSING="$MISSING $M"
        fi
    done

    # 2. FUNCTIONAL TEST (Specific for xt_connlimit)
    # This module is often statically built into Keenetic kernels without file traces.
    # We attempt to insert a dummy rule. If iptables accepts it, the module is present.
    if ! iptables -A INPUT -p tcp --dport 9999 -m connlimit --connlimit-above 100 -j RETURN >/dev/null 2>&1; then
         # Rule failed: Module is missing
         MISSING="$MISSING xt_connlimit"
    else
         # Rule accepted: Module exists. Remove the dummy rule immediately.
         iptables -D INPUT -p tcp --dport 9999 -m connlimit --connlimit-above 100 -j RETURN >/dev/null 2>&1
    fi

    # 3. FINAL REPORT
    if [ -n "$MISSING" ]; then
        echo -e "${RED}Failed${RESET}"
        echo -e "${YELLOW}    [!] Missing Critical Modules:${RESET} ${BOLD}$MISSING${RESET}"
        echo -e "    Please check 'Netfilter' components in Keenetic firmware."
        return 1
    else
        echo -e "${GREEN}OK${RESET}"
        return 0
    fi
}

verify_new_firewall_reqs() {
    echo -n " -> Checking Remote Suite Version... "
    TMP_HOOK="/tmp/chk_fw_hook.sh"
    curl -fsSL --connect-timeout 10 --max-time 60 --retry 1 "$BASE_URL/$FW_REPO/main/scripts/100-firewall.sh" -o "$TMP_HOOK"
    
    IS_NEW_SUITE=0
    if [ -s "$TMP_HOOK" ] && grep -q "NFLOG" "$TMP_HOOK"; then
        IS_NEW_SUITE=1
        echo -e "${MAGENTA}New v2.3+ (ULOGD) detected${RESET}"
    else
        echo -e "${CYAN}Standard/Legacy detected${RESET}"
    fi
    rm -f "$TMP_HOOK"

    if [ "$IS_NEW_SUITE" -eq 1 ]; then
        # A. ULOGD Installation (NFlog + PCAP)
        if ! opkg list-installed | grep -q "^ulogd-mod-pcap"; then
            echo -n "    -> New suite requires ${BOLD}ulogd (nflog/pcap)${RESET}. Installing... "
            opkg update >/dev/null 2>&1
            opkg install ulogd ulogd-mod-nflog ulogd-mod-pcap >/dev/null 2>&1
            if [ $? -eq 0 ]; then echo -e "${GREEN}Installed${RESET}"; else echo -e "${RED}Failed${RESET}"; return 1; fi
        fi

        # B. ULOGD Settings
        echo -n "    -> Configuring ulogd... "
        cat > /opt/etc/ulogd.conf <<EOF
[global]
logfile="/opt/var/log/ulogd.log"
loglevel=3
plugin="/opt/lib/ulogd/ulogd_inppkt_NFLOG.so"
plugin="/opt/lib/ulogd/ulogd_raw2packet_BASE.so"
plugin="/opt/lib/ulogd/ulogd_output_PCAP.so"
stack=log1:NFLOG,base1:BASE,pcap1:PCAP

[log1]
group=1

[pcap1]
file="/tmp/fw_syn_ring.pcap"
sync=1
EOF
        chmod 644 /opt/etc/ulogd.conf
        echo -e "${GREEN}Done${RESET}"

        # C. Script S11ulogd
        if [ ! -f "/opt/etc/init.d/S11ulogd" ]; then
            echo -n "    -> Creating startup script (S11ulogd)... "
            cat > /opt/etc/init.d/S11ulogd <<EOF
#!/opt/bin/bash

ENABLED=yes
PROCS=ulogd
ARGS="-d"
PREARGS=""
DESC=\$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

. /opt/etc/init.d/rc.func
EOF
            chmod +x /opt/etc/init.d/S11ulogd
            echo -e "${GREEN}Created${RESET}"
        fi
        
        # Restart service.
        /opt/etc/init.d/S11ulogd restart >/dev/null 2>&1

        # D. Verify kernel modules.
        check_firewall_mods
        return $?
    fi
    return 0
}

