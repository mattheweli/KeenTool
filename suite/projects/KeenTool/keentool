    awk -v v1="$1" -v v2="$2" 'BEGIN { 
        split(v1,a,"."); split(v2,b,"."); 
        for(i=1;i<=3;i++) { 
            if(a[i]+0 > b[i]+0) exit 1; 
            if(a[i]+0 < b[i]+0) exit 2; 
        } 
        exit 0; 
    }'
    return $? 
}

