# --- HEADLESS SELF-UPDATE (CLI - NOTIFY ONLY) ---
perform_self_update_headless() {
    if [ "${KT_MANAGED_PACKAGE:-false}" = true ]; then /opt/bin/bash /opt/bin/keentool_update --check; return 0; fi
    IFS='|' read -r N P R F <<EOF
$T_SELF
EOF
    TMP_FILE="/tmp/keentool_bg.tmp"
    curl -fsSL --connect-timeout 10 --max-time 60 --retry 1 "$BASE_URL/$R/main/$F" -o "$TMP_FILE"
    
    if [ ! -s "$TMP_FILE" ]; then 
        rm -f "$TMP_FILE"
        exit 1
    fi
    
    sed -i 's/\r$//' "$TMP_FILE"
    L_VER=$(get_version "$P")
    R_VER=$(get_version "$TMP_FILE")
    
    ver_compare "$R_VER" "$L_VER"
    RES=$?
    # If an update is available
    if [ $RES -eq 1 ] || { [ $RES -eq 0 ] && [ "$(get_md5 "$P")" != "$(get_md5 "$TMP_FILE")" ]; }; then
        # 1. Save the available version to a temporary file for the menu
        echo "$R_VER" > "/tmp/keentool_new_ver"
        
        MSG="Update Available: KeenTool v$R_VER is available. Check menu option 's'."
        logger -t "KeenTool" "$MSG"
        /opt/bin/email_sender.mod "KeenTool Update Available" "$MSG" &
    else
        # If up to date, remove any old warning flags
        rm -f "/tmp/keentool_new_ver"
    fi
    
    rm -f "$TMP_FILE"
    exit 0
}

