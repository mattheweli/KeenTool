get_version() { 
    if [ -f "$1" ]; then
        VER=$(head -n 20 "$1" | grep -oE "v[0-9]+\.[0-9]+\.[0-9]+" | head -n 1)
    fi
    if [ -z "$VER" ]; then
        echo "0.0.0"
    else
        echo "${VER#v}"
    fi
}

get_md5() { 
    if [ -f "$1" ]; then
        md5sum "$1" | awk '{print $1}'
    else
        echo "none"
    fi
}

get_device_id() {
    if [ ! -s "$ID_FILE" ]; then
        if [ -f /proc/sys/kernel/random/uuid ]; then
            cat /proc/sys/kernel/random/uuid > "$ID_FILE"
        else
            echo "$(date +%s)$RANDOM" | md5sum | awk '{print $1}' > "$ID_FILE"
        fi
    fi
    cat "$ID_FILE" | tr -d '[:space:]'
}

