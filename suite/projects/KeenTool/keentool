    echo 'Scheduled jobs:'; grep -E 'pingtool|traffic_manager|firewall|vpn_scan|abuse_reporter|smb_backup|keentool' /opt/etc/crontab 2>/dev/null || :
    echo 'Service states:'; ps | grep -E 'lighttpd|ulogd|crond|vnstatd' | grep -v grep || :
