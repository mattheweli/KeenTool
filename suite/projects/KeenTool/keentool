# --- DEPENDENCY & INSTALL ---
check_and_install_deps() {
    PKG_LIST="$1"; MISSING=""
    for PKG in $PKG_LIST; do 
        if opkg list-installed | grep -q "^$PKG"; then continue; fi
        if command -v "$PKG" >/dev/null 2>&1; then continue; fi
        MISSING="$MISSING $PKG"
    done
    if [ -n "$MISSING" ]; then
        echo -e " -> ${YELLOW}Missing:${RESET} $MISSING"; echo -n " -> Install? (y/n): "; read -r ans
        if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then
            echo "    Installing..."; opkg update >/dev/null 2>&1; opkg install $MISSING
            if echo "$PKG_LIST" | grep -q "lighttpd"; then check_webserver_config "check"; fi
            if echo "$PKG_LIST" | grep -q "vnstat2"; then check_vnstat_config; fi
        else return 1; fi
    else echo -e " -> ${GREEN}OK${RESET}"; fi
    if echo "$PKG_LIST" | grep -q "lighttpd"; then check_webserver_config "check"; fi
    if echo "$PKG_LIST" | grep -q "vnstat2"; then check_vnstat_config; fi
    return 0
}

check_vnstat_config() {
    CONF="/opt/etc/vnstat.conf"
    if [ ! -f "$CONF" ]; then
        echo -n " -> ${YELLOW}Configure vnStat (Download Config)? (y/n): ${RESET}"; read -r ans
        if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then
            echo -n "    Downloading vnstat.conf from KeenTool repo... "
            curl -fsSL --connect-timeout 10 --max-time 60 --retry 1 "$BASE_URL/KeenTool/main/vnstat.conf" -o "$CONF"
            if [ -s "$CONF" ]; then
                echo -e "${GREEN}OK${RESET}"; chmod 644 "$CONF"
            else
                echo -e "${RED}Failed (Using Minimal Fallback)${RESET}"
                echo 'Interface ""' > "$CONF"; echo 'DatabaseDir "/opt/var/lib/vnstat"' >> "$CONF"
            fi
            if [ -x /opt/etc/init.d/S32vnstat2 ]; then /opt/etc/init.d/S32vnstat2 restart >/dev/null 2>&1; fi
        fi
    fi
}

check_webserver_config() {
    MODE=$1; CONF="/opt/etc/lighttpd/lighttpd.conf"
    if [ ! -d "$WEB_ROOT" ]; then mkdir -p "$WEB_ROOT"; fi
    
    if [ ! -f "$WEB_ROOT/index.html" ] || [ "$MODE" = "force" ]; then
         echo -n " -> Downloading Dashboard to $WEB_ROOT... "
         curl -fsSL --connect-timeout 10 --max-time 60 --retry 1 "$BASE_URL/KeenTool/main/index.html" -o "$WEB_ROOT/index.html"
         [ -s "$WEB_ROOT/index.html" ] && chmod 644 "$WEB_ROOT/index.html"
    fi
    if [ -f "$CONF" ]; then
        if grep -q "/opt/var/www/" "$CONF" && [ "$MODE" != "force" ]; then return 0; fi
    fi
    if [ "$MODE" != "force" ]; then
        echo -n " -> ${YELLOW}Configure Lighttpd (Port 8080)? (y/n): ${RESET}"; read -r ans
        [ "$ans" != "y" ] && [ "$ans" != "Y" ] && return 0
    fi
    mkdir -p /opt/etc/lighttpd
    cat > "$CONF" <<EOF
var.log_root    = "/opt/var/log/lighttpd/"
var.server_root = "/opt/var/www/"
var.state_dir   = "/opt/var/run/"
var.home_dir    = "/opt/var/lib/lighttpd/"
var.conf_dir    = "/opt/etc/lighttpd"
var.vhosts_dir  = server_root + "/vhosts"
var.cache_dir   = "/opt/var/cache/lighttpd"
var.socket_dir  = home_dir + "/sockets"
server.document-root = server_root
server.upload-dirs = ( "/opt/tmp" )
server.errorlog = log_root + "error.log"
server.pid-file = state_dir + "lighttpd.pid"
server.port = 81
index-file.names = ( "index.php", "index.html", "index.htm" )
static-file.exclude-extensions = ( ".pl", ".fcgi", ".cgi" )

server.modules = (
    "mod_access",
    "mod_alias",
    "mod_fastcgi"
)

include "/opt/etc/lighttpd/mime.conf"
include "/opt/etc/lighttpd/conf.d/*.conf"
EOF
    [ -x /opt/etc/init.d/S80lighttpd ] && { /opt/etc/init.d/S80lighttpd restart >/dev/null 2>&1; echo -e "    ${GREEN}Configured & Restarted.${RESET}"; }
}

configure_dashboard_extras() {
    # 1. Always link main message log
    if [ ! -L "$WEB_ROOT/messages.log" ]; then
        echo -n " -> Linking System Log to Web Root... "
        ln -sf /opt/var/log/messages "$WEB_ROOT/messages.log"
        echo -e "${GREEN}Done.${RESET}"
    fi

    # 2. Setup Services
    if [ -x /opt/etc/init.d/S01syslog-ng ]; then
        if ! pidof syslog-ng >/dev/null; then /opt/etc/init.d/S01syslog-ng start; fi
    fi
    if [ -f /opt/etc/logrotate.conf ]; then
        chmod 644 /opt/etc/logrotate.conf
        [ -d /opt/etc/logrotate.d ] && chmod 755 /opt/etc/logrotate.d
        if ! grep -q "logrotate" "$CRON_FILE"; then
            echo "0 4 * * * root /opt/sbin/logrotate /opt/etc/logrotate.conf" >> "$CRON_FILE"
            sanitize_and_reload_cron
        fi
    fi

    # 3. Handle Configuration (Silent vs Interactive)
    if [ "$1" = "silent" ]; then
        reapply_dashboard_config
    else
        configure_logging_modules
    fi
}

# --- GENERIC INSTALL/UPDATE HELPERS ---
install_file() {
    if [ "${KT_MANAGED_PACKAGE:-false}" = true ]; then /opt/bin/bash /opt/bin/keentool_update; return 0; fi
    local REPO=$1 RFILE=$2 LPATH=$3 DIR TMP SAVE
    DIR=$(dirname "$LPATH"); mkdir -p "$DIR"
    TMP=$(mktemp "${LPATH}.XXXXXX") || return 1
    if ! kt_download "$BASE_URL/$REPO/main/$RFILE" "$TMP" || ! kt_validate "$TMP"; then rm -f "$TMP"; echo 'Download/syntax validation failed'; return 1; fi
    if [ -f "$LPATH" ]; then
        SAVE=/opt/var/backups/keentool-updates/$(date +%Y%m%d_%H%M%S); mkdir -p "$SAVE"; cp -p "$LPATH" "$SAVE/$(basename "$LPATH")" || return 1
    fi
    apply_perms "$TMP"; mv "$TMP" "$LPATH"; apply_perms "$LPATH"
    echo 'Installed verified file'

}

smart_process() {
    if [ "${KT_MANAGED_PACKAGE:-false}" = true ]; then /opt/bin/bash /opt/bin/keentool_update; return 0; fi
    NAME=$1; LPATH=$2; REPO=$3; RFILE=$4
    if [ ! -f "$LPATH" ]; then
        echo -e "${BOLD}Installing: $NAME${RESET}"; echo -n " -> Confirm? (y/n): "; read -r ans
        [ "$ans" = "y" ] || [ "$ans" = "Y" ] && install_file "$REPO" "$RFILE" "$LPATH"
        return
    fi
    echo -n "Checking $NAME... "; TMP_FILE="/tmp/${RFILE##*/}.tmp"; curl -fsSL --connect-timeout 10 --max-time 60 --retry 1 "$BASE_URL/$REPO/main/$RFILE" -o "$TMP_FILE"
    if [ ! -s "$TMP_FILE" ]; then echo -e "${RED}Net Error${RESET}"; rm -f "$TMP_FILE"; return; fi
    sed -i 's/\r$//' "$TMP_FILE"
    L_VER=$(get_version "$LPATH"); R_VER=$(get_version "$TMP_FILE"); ver_compare "$R_VER" "$L_VER"; RES=$?
    UPDATE_NEEDED=0; MSG=""
    if [ $RES -eq 1 ]; then 
        UPDATE_NEEDED=1; MSG="${MAGENTA}Update: v$L_VER -> v$R_VER${RESET}"
    elif [ $RES -eq 0 ] && [ "$NAME" != "Main Dashboard" ] && [ "$NAME" != "Ping Monitor" ] && [ "$NAME" != "Traffic Manager" ] && [ "$(get_md5 "$LPATH")" != "$(get_md5 "$TMP_FILE")" ]; then 
        # Ignore MD5 check for files that auto-modify via user settings
        UPDATE_NEEDED=1; MSG="${CYAN}Content Changed (Patch)${RESET}"
    fi
    if [ $UPDATE_NEEDED -eq 1 ]; then
        echo -e "$MSG"; echo -n "    Apply? (y/n): "; read -r ans
        [ "$ans" = "y" ] && { 
            kt_validate "$TMP_FILE" || { echo 'Syntax check failed'; rm -f "$TMP_FILE"; return 1; }
            cp -p "$LPATH" "${LPATH}.previous" || return 1
            mv "$TMP_FILE" "$LPATH"
            apply_perms "$LPATH"
            echo -e "    ${GREEN}Updated.${RESET}"
        } || rm -f "$TMP_FILE"
    else
        rm -f "$TMP_FILE"; echo -e "${GREEN}Up to date.${RESET}"
    fi
}

# --- CRON MANAGEMENT ---
sanitize_and_reload_cron() {
    [ ! -f "$CRON_FILE" ] && touch "$CRON_FILE"
    awk 'length($0) == 0 || !seen[$0]++' "$CRON_FILE" > "$CRON_FILE.tmp" && mv "$CRON_FILE.tmp" "$CRON_FILE"
    if [ -s "$CRON_FILE" ] && [ "$(tail -c 1 "$CRON_FILE")" != "" ]; then echo "" >> "$CRON_FILE"; fi
    chmod 600 "$CRON_FILE"
    
    # Fix: Remove user spool to avoid duplicate executions
    if [ -f "$CRON_SPOOL_FILE" ]; then 
        echo "Preserving user cron spool: $CRON_SPOOL_FILE"
    fi
    
    if [ -x /opt/etc/init.d/S10cron ]; then /opt/etc/init.d/S10cron restart >/dev/null 2>&1; fi
}

action_verify_cron() {
    header; echo -e "${BOLD}Verifying Crontab Integrity...${RESET}"
    CRON_PATH="/opt/etc/crontab"
    if [ ! -f "$CRON_PATH" ]; then echo -n " -> File missing. Creating... "; touch "$CRON_PATH"; echo -e "${GREEN}Created.${RESET}"; else echo -e " -> File exists."; fi
    echo -n " -> Cleaning & Fixing Permissions... "
    sanitize_and_reload_cron
    echo -e "${GREEN}Done.${RESET}"
    echo ""; echo -e "${GREEN}Verification Complete.${RESET}"; pause
}

# --- HELPER: Extract "pure" command (removes root prefix and redirects) ---
get_clean_cmd_str() {
    # Input example: "root /opt/bin/script.sh 'ppp0 br0' > /dev/null"
    # Output: "/opt/bin/script.sh 'ppp0 br0'"
    # Note: We must preserve the exact quotes for matching
    echo "$1" | sed -E 's/^.*root //; s/ >.*//; s/ >>.*//' | sed 's/[[:space:]]*$//'
}

cron_cmd_active() { 
    CMD_STR="$1"
    # Identify unique string (path + args)
    SEARCH_STR=$(get_clean_cmd_str "$CMD_STR")
    # Use grep Fixed string (-F) to avoid regex issues with paths
    grep -qF "$SEARCH_STR" "$CRON_FILE" 
}

get_cron_line() { 
    CMD_STR="$1"
    SEARCH_STR=$(get_clean_cmd_str "$CMD_STR")
    grep -F "$SEARCH_STR" "$CRON_FILE" | head -n 1
}

interactive_cron_builder() {
    CMD_TO_ADD="$1"
    # 1. Prepare Display Name (Filename + Arguments)
    CLEAN_CMD=$(get_clean_cmd_str "$CMD_TO_ADD")
    BASENAME=$(basename "$(echo "$CLEAN_CMD" | awk '{print $1}')")
    ARGS=$(echo "$CLEAN_CMD" | cut -d' ' -f2-)
    
    # If arguments exist, append them to the display name
    [ "$ARGS" != "$CLEAN_CMD" ] && DISP_NAME="$BASENAME $ARGS" || DISP_NAME="$BASENAME"

    # 2. Check for collisions
    if grep -qF "$CLEAN_CMD" "$CRON_FILE"; then
        echo -e "${YELLOW}Warning: Existing jobs found for $DISP_NAME:${RESET}"; 
        grep -F "$CLEAN_CMD" "$CRON_FILE"; echo ""
        echo -n "Do you want to REPLACE them with the new schedule? (y/n): "; read -r confirm
        if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then echo "Operation cancelled."; return; fi
        
        # Remove only lines matching exact command+args
        grep -vF "$CLEAN_CMD" "$CRON_FILE" > "$CRON_FILE.tmp" && mv "$CRON_FILE.tmp" "$CRON_FILE"; echo -e "${RED}Old entries removed.${RESET}"
    fi

    # 3. Schedule Menu
    echo -e "${CYAN}Configure Schedule ($DISP_NAME):${RESET}"
    echo " 1. Every X Minutes"
    echo " 2. Every X Hours"
    echo " 3. Daily (Specific Time)"
    echo " 4. Weekly (Specific Day & Time)"
    echo " 5. Monthly (Specific Date & Time)"
    echo -n "Select [1-5]: "; read -r opt
    
    SCHED=""
    case $opt in
        1) echo -n "Minutes (e.g. 10): "; read -r mins; [ -z "$mins" ] && mins="10"; SCHED="*/$mins * * * *" ;;
        2) echo -n "Hours (e.g. 1): "; read -r hrs; [ -z "$hrs" ] && hrs="1"; SCHED="0 */$hrs * * *" ;;
        3) echo -n "Hour (0-23): "; read -r hh; echo -n "Minute (0-59): "; read -r mm
           [ -z "$hh" ] && hh="03"; [ -z "$mm" ] && mm="00"; SCHED="$mm $hh * * *" ;;
        4) echo -n "Day of Week (0=Sun...6=Sat): "; read -r dow; echo -n "Hour (0-23): "; read -r hh
           echo -n "Minute (0-59): "; read -r mm
           [ -z "$dow" ] && dow="0"; [ -z "$hh" ] && hh="03"; [ -z "$mm" ] && mm="00"; SCHED="$mm $hh * * $dow" ;;
        5) echo -n "Day of Month (1-31): "; read -r dom; echo -n "Hour (0-23): "; read -r hh
           echo -n "Minute (0-59): "; read -r mm
           [ -z "$dom" ] && dom="1"; [ -z "$hh" ] && hh="03"; [ -z "$mm" ] && mm="00"; SCHED="$mm $hh $dom * *" ;;
        *) echo "Invalid. Defaulting to daily 04:00."; SCHED="0 4 * * *" ;;
    esac
    
    # 4. Write to Crontab
    echo -e " -> Adding: ${BOLD}$SCHED $CMD_TO_ADD${RESET}"
    echo "$SCHED $CMD_TO_ADD" >> "$CRON_FILE"
    sanitize_and_reload_cron
    echo -e "    ${GREEN}Scheduled & Cron Reloaded.${RESET}"
}

remove_cron_cmd() {
    CMD_TO_REM="$1"
    # Precise identification via path+args
    CLEAN_CMD=$(get_clean_cmd_str "$CMD_TO_REM")
    
    # Inverse grep (-v) on fixed string (-F)
    grep -vF "$CLEAN_CMD" "$CRON_FILE" > "$CRON_FILE.tmp" && mv "$CRON_FILE.tmp" "$CRON_FILE"; sanitize_and_reload_cron
    echo -e "    ${RED}Removed ($CLEAN_CMD) & Cron Reloaded.${RESET}"
}

manage_cron_menu() {
    while true; do
        clear
        echo -e "${BOLD}${BLUE}======================================================${RESET}"
        echo -e "${BOLD}${BLUE}   MANAGE CRON JOBS${RESET}"
        echo -e "${BOLD}${BLUE}======================================================${RESET}"
        echo ""
        
        i=1
        for CMD in "$@"; do
            # Build Smart Label (Filename + Args)
            CLEAN_CMD=$(get_clean_cmd_str "$CMD")
            BASENAME=$(basename "$(echo "$CLEAN_CMD" | awk '{print $1}')")
            ARGS=$(echo "$CLEAN_CMD" | cut -d' ' -f2-)
            
            # If args exist, show them. Otherwise just filename.
            if [ "$ARGS" != "$CLEAN_CMD" ]; then
                DISP_NAME="$BASENAME $ARGS"
            else
                DISP_NAME="$BASENAME"
            fi
            
            if cron_cmd_active "$CMD"; then
                EXISTING=$(get_cron_line "$CMD"); RAW_M=$(echo "$EXISTING" | awk '{print $1}')
                RAW_H=$(echo "$EXISTING" | awk '{print $2}')
                RAW_D=$(echo "$EXISTING" | awk '{print $3}')
                RAW_O=$(echo "$EXISTING" | awk '{print $4}')
                RAW_W=$(echo "$EXISTING" | awk '{print $5}')
           
                READABLE=$(cron_to_human "$RAW_M" "$RAW_H" "$RAW_D" "$RAW_O" "$RAW_W")
                echo -e " $i. [${GREEN}ON${RESET}] $DISP_NAME (${DIM}$READABLE${RESET})"
            else
                echo -e " $i. [${RED}OFF${RESET}] $DISP_NAME"
            fi
       
             i=$((i+1))
        done
    
        echo ""; echo " 0. Back"; echo ""
        echo -n "Select Job to Manage: "; read -r sel
        
        if [ "$sel" = "0" ] || [ -z "$sel" ]; then return; fi
        
        idx=1; TARGET_CMD=""
        for CMD in "$@"; do
            if [ "$idx" -eq "$sel" ]; then TARGET_CMD="$CMD"; break; fi
            idx=$((idx+1))
        done
        
        if [ -n "$TARGET_CMD" ]; then
            echo ""
            # Recalculate name for visual feedback
            CLEAN_CMD=$(get_clean_cmd_str "$TARGET_CMD")
            BASENAME=$(basename "$(echo "$CLEAN_CMD" | awk '{print $1}')")
            ARGS=$(echo "$CLEAN_CMD" | cut -d' ' -f2-)
            [ "$ARGS" != "$CLEAN_CMD" ] && DISP_NAME="$BASENAME $ARGS" || DISP_NAME="$BASENAME"
            
            if cron_cmd_active "$TARGET_CMD"; then
                echo -e "Selected: ${BOLD}$DISP_NAME${RESET} (Active)"
                echo " 1. Edit Schedule"
                echo " 2. Disable / Remove"
                echo " 0. Cancel"
                echo -n "Option: "; read -r subopt
                case $subopt in
                    1) interactive_cron_builder "$TARGET_CMD"; pause ;;
                    2) remove_cron_cmd "$TARGET_CMD"; pause ;;
                esac
            else
                echo -e "Selected: ${BOLD}$DISP_NAME${RESET} (Inactive)"
                echo " 1. Enable (Configure Schedule)"
                echo " 0. Cancel"
                echo -n "Option: "; read -r subopt
                case $subopt in
                    1) interactive_cron_builder "$TARGET_CMD"; pause ;;
                esac
            fi
        fi
    done
}

