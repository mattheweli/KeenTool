                [ "$EN_DNS" = "yes" ] && echo 'log { source(s_local); source(s_network); filter(f_dns); destination(d_dns); };' >> /opt/etc/syslog-ng.conf
                [ "$EN_WIFI" = "yes" ] && echo 'log { source(s_local); source(s_network); filter(f_wifi); destination(d_wifi); };' >> /opt/etc/syslog-ng.conf
                [ "$EN_DHCP" = "yes" ] && echo 'log { source(s_local); source(s_network); filter(f_dhcp); destination(d_dhcp); };' >> /opt/etc/syslog-ng.conf
                [ "$EN_VPN" = "yes" ] && echo 'log { source(s_local); source(s_network); filter(f_vpn); destination(d_vpn); };' >> /opt/etc/syslog-ng.conf
                [ "$EN_SCRIPTS" = "yes" ] && echo 'log { source(s_local); source(s_network); filter(f_scripts); destination(d_scripts); };' >> /opt/etc/syslog-ng.conf
                [ "$EN_PROXY" = "yes" ] && echo 'log { source(s_local); source(s_network); filter(f_proxy); destination(d_proxy); };' >> /opt/etc/syslog-ng.conf
                
                # ULOGD Marker (for future compatibility if dash.conf is lost)
                if [ "$EN_ULOGD" = "yes" ]; then echo "" >> /opt/etc/syslog-ng.conf; echo "# ulogd_enabled" >> /opt/etc/syslog-ng.conf; fi

                # 3. GENERATE LOGROTATE (Syslog)
                echo "/opt/var/log/messages { rotate 4 size 5M missingok notifempty compress postrotate /opt/etc/init.d/S01syslog-ng restart >/dev/null 2>&1 endscript }" > /opt/etc/logrotate.d/syslog-ng
                
                SECLOGS=""
              
                [ "$EN_DNS" = "yes" ] && SECLOGS="$SECLOGS /opt/var/log/dns_proxy.log"
                [ "$EN_WIFI" = "yes" ] && SECLOGS="$SECLOGS /opt/var/log/wifi_monitor.log"
                [ "$EN_DHCP" = "yes" ] && SECLOGS="$SECLOGS /opt/var/log/ndhcps.log"
                [ "$EN_VPN" = "yes" ] && SECLOGS="$SECLOGS /opt/var/log/vpn.log"
                [ "$EN_SCRIPTS" = "yes" ] && SECLOGS="$SECLOGS /opt/var/log/keentool.log"
                [ "$EN_PROXY" = "yes" ] && SECLOGS="$SECLOGS /opt/var/log/nginx_proxy.log"
                
                if [ -n "$SECLOGS" ]; then
                    echo "$SECLOGS {" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    monthly" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    rotate 2" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    size 5M" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    missingok" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    notifempty" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    compress" >> /opt/etc/logrotate.d/syslog-ng
            
                    echo "    postrotate" >> /opt/etc/logrotate.d/syslog-ng
                    echo "        /opt/etc/init.d/S01syslog-ng restart > /dev/null 2>&1" >> /opt/etc/logrotate.d/syslog-ng
                    echo "    endscript" >> /opt/etc/logrotate.d/syslog-ng
                    echo "}" >> /opt/etc/logrotate.d/syslog-ng
                fi

                # Logrotate ULOGD (Separate Block)
                if [ -f "/opt/var/log/ulogd.log" ]; then
                    cat >> /opt/etc/logrotate.d/syslog-ng <<EOF

/opt/var/log/ulogd.log {
    rotate 4
    size 10M
    missingok
    notifempty
    compress
    postrotate
        killall -HUP ulogd 2>/dev/null || /opt/etc/init.d/S11ulogd restart >/dev/null 2>&1
    endscript
}
EOF
                fi

                # 4. PATCH INDEX.HTML
                reapply_dashboard_config

                # 5. RESTART
                echo " -> Restarting Syslog-ng..."
    
                /opt/etc/init.d/S01syslog-ng restart >/dev/null 2>&1
                echo -e "${GREEN}Done. Configuration applied.${RESET}"
                sleep 1; return ;;
            0) return ;;
        esac
    done
}

configure_traffic() {
    # 1. Safely extracts interfaces
    CUR_IFACE=$(echo "$CMD_VNSTAT" | sed -n "s/.*traffic_manager.sh '\([^']*\)'.*/\1/p")
    [ -z "$CUR_IFACE" ] && CUR_IFACE="ppp0"

    while true; do
        header
        echo -e "${BOLD}Traffic Manager Configuration${RESET}"
        echo ""
        echo -e " Current Dashboard Targets: ${CYAN}${CUR_IFACE}${RESET}"
        echo ""
        
        echo -e "${BOLD}Available Interfaces (VNStat DB):${RESET}"
        if command -v vnstat >/dev/null 2>&1; then
            vnstat --iflist 2>/dev/null | awk '{print "  - " $0}'
        else
            echo "  (VNStat not found)"
        fi
        
        echo ""
        echo " 1. Set Dashboard Interfaces (Multi-Tab support)"
        echo " 2. Add New Interface to DB (vnstat --add)"
        echo " 3. Remove Interface from DB (vnstat --remove)"
        echo " 0. Back"
        echo ""
        echo -n "Select option: "; read -r opt
        
        case $opt in
            1) 
                echo -n "Enter Interfaces (space separated, e.g. ppp0 br0): "
                read -r NEW_IF
                # Pulisce spazi multipli o finali
                NEW_IF=$(echo "$NEW_IF" | xargs)
                if [ -n "$NEW_IF" ]; then
                    # Update CMD_VNSTAT for the current session.
                    NEW_CMD="root /opt/bin/traffic_manager.sh '$NEW_IF' >/opt/var/log/t_manager.log 2>&1"
                    
                    # Update the installed KeenTool file (this script).
                    sed -i -E "s|CMD_VNSTAT=\"root /opt/bin/traffic_manager.sh.*\"|CMD_VNSTAT=\"$NEW_CMD\"|" "$0"
                    
                    # Find and replace cron entries while preserving quotes.
                    if grep -q "traffic_manager.sh" "$CRON_FILE"; then
                        echo " -> Updating Crontab..."
                        grep -v "traffic_manager.sh" "$CRON_FILE" > "$CRON_FILE.tmp" && mv "$CRON_FILE.tmp" "$CRON_FILE"
                        echo "*/10 * * * * $NEW_CMD" >> "$CRON_FILE"
                        sanitize_and_reload_cron
                    fi
                    
                    # Update the global menu variable.
                    CMD_VNSTAT="$NEW_CMD"
                    CUR_IFACE="$NEW_IF"
                    
                    echo " -> Regenerating Dashboard instantly..."
                    rm -f /opt/var/www/vnstat/index.html
                    /opt/bin/traffic_manager.sh "$NEW_IF" >/dev/null 2>&1
                    
                    echo -e " -> ${GREEN}Targets set to: $NEW_IF${RESET}"
                    sleep 1
                fi
                ;;
            2)
                echo -n "Enter Interface to ADD (e.g. usb0): "
                read -r ADD_IF
                if [ -n "$ADD_IF" ]; then
                    echo " -> Adding $ADD_IF..."
                    vnstat --add -i "$ADD_IF"
                    /opt/etc/init.d/S32vnstat2 restart
                    echo -e " -> ${GREEN}Done. Please allow ~10m for data collection.${RESET}"
                    pause
                fi
                ;;
            3)
                echo -n "Enter Interface to REMOVE (e.g. eth0): "
                read -r DEL_IF
                if [ -n "$DEL_IF" ]; then
                    echo " -> Removing $DEL_IF..."
                    vnstat --remove -i "$DEL_IF" --force
                    /opt/etc/init.d/S32vnstat2 restart
                    echo -e " -> ${RED}Removed.${RESET}"
                    pause
                fi
                ;;
            0) return ;;
        esac
    done
}

configure_pingtool() {
    P=/opt/etc/pingtool.conf
    if [ ! -f "$P" ]; then
        grep -E '^(PING_TARGET|PING_TARGET_V6|PING_DURATION|TRIGGER_LATENCY|RETENTION_DAYS|MAX_DISPLAY_POINTS|ENABLE_IPV6|EMAIL_ALERTS|WAN_LABEL|WAN_MONITOR_INTERVAL|WAN_SYSLOG_ENABLED|WAN_SYSLOG_FILE)=' /opt/bin/pingtool.sh > "$P"
        chmod 600 "$P"
    fi
    if [ ! -f "$P" ]; then 
        echo -e "${RED}Error: Ping Monitor is not installed.${RESET}"
        pause
        return
    fi
    
    NEED_REFRESH=0
    
    while true; do
        header
        echo -e "${BOLD}Ping Monitor Configuration${RESET}"
        
        CUR_V4=$(grep '^PING_TARGET="' "$P" | cut -d'"' -f2)
        CUR_V6=$(grep '^PING_TARGET_V6="' "$P" | cut -d'"' -f2)
        CUR_MODE=$(grep '^ENABLE_IPV6="' "$P" | cut -d'"' -f2)
        CUR_DUR=$(grep '^PING_DURATION=' "$P" | cut -d'=' -f2)
        CUR_LAT=$(grep '^TRIGGER_LATENCY=' "$P" | cut -d'=' -f2)
  
        CUR_RET=$(grep '^RETENTION_DAYS=' "$P" | cut -d'=' -f2)
        CUR_POINTS=$(grep '^MAX_DISPLAY_POINTS=' "$P" | cut -d'=' -f2); CUR_POINTS=${CUR_POINTS:-2000}
        CUR_WAN=$(grep '^WAN_LABEL="' "$P" | cut -d'"' -f2); CUR_WAN=${CUR_WAN:-Auto (route interface)}
        CUR_WAN_INTERVAL=$(grep '^WAN_MONITOR_INTERVAL=' "$P" | cut -d'=' -f2); CUR_WAN_INTERVAL=${CUR_WAN_INTERVAL:-5}
		CUR_ALERTS=$(grep '^EMAIL_ALERTS="' "$P" | cut -d'"' -f2)
		
		if [ "$CUR_ALERTS" = "true" ]; then LBL_MAIL="${GREEN}ON${RESET}"; else LBL_MAIL="${RED}OFF${RESET}"; fi
        
        if [ "$CUR_MODE" = "true" ]; then LBL_MODE="${GREEN}Enabled${RESET}"; else LBL_MODE="${RED}Disabled${RESET}"; fi
        
        echo ""
        echo -e " ${BOLD}Targets:${RESET}"
        echo -e " 1. Set IPv4 Target      [Current: ${CYAN}$CUR_V4${RESET}]"
        echo -e " 2. Set IPv6 Target      [Current: ${CYAN}$CUR_V6${RESET}]"
        echo -e " 3. Toggle IPv6 Mode     [$LBL_MODE]"
       
        echo ""
        echo -e " ${BOLD}Parameters:${RESET}"
        echo -e " 4. Ping Duration        [Current: ${CYAN}${CUR_DUR}s${RESET}]"
        echo -e " 5. Trigger Latency      [Current: ${CYAN}${CUR_LAT}ms${RESET}]"
        echo -e " 6. DB Retention Days    [Current: ${CYAN}${CUR_RET} days${RESET}]"
		echo -e " 7. Email Alerts         [$LBL_MAIL]"
        echo -e " 8. Maximum Chart Points [Current: ${CYAN}${CUR_POINTS}${RESET}]"
        echo -e " 9. Notification WAN     [Current: ${CYAN}${CUR_WAN}${RESET}]"
        echo -e " 10. PPP Monitor Interval [Current: ${CYAN}${CUR_WAN_INTERVAL}s${RESET}]"
        echo "    Retention controls original samples; chart points only control display detail."
        echo ""
  
        echo " 0. Back"
        echo ""
        echo -n "Select setting to change: "; read -r opt
        
        case $opt in
            1) echo -n "Enter new IPv4 Target (e.g., 1.1.1.1): "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
                   sed -i 's/^PING_TARGET=".*"/PING_TARGET="'$NEW_VAL'"/' "$P"
                   echo -e " -> ${GREEN}Updated.${RESET}"; NEED_REFRESH=1
               fi ;;
            2) echo -n "Enter new IPv6 Target: "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
                   sed -i 's/^PING_TARGET_V6=".*"/PING_TARGET_V6="'$NEW_VAL'"/' "$P"
                   echo -e " -> ${GREEN}Updated.${RESET}"; NEED_REFRESH=1
               fi ;;
            3) if [ "$CUR_MODE" = "true" ]; then NEW_MODE="false"; else NEW_MODE="true"; fi
               sed -i 's/^ENABLE_IPV6=".*"/ENABLE_IPV6="'$NEW_MODE'"/' "$P"
               echo -e " -> Mode switched to: $NEW_MODE"; NEED_REFRESH=1 ;;
            4) echo -n "Enter Duration (seconds, e.g. 30): "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[0-9]+$ ]] && [ "$NEW_VAL" -ge 1 ] && [ "$NEW_VAL" -le 50 ]; then
                   sed -i "s/^PING_DURATION=.*/PING_DURATION=$NEW_VAL/" "$P"
                   echo -e " -> ${GREEN}Updated.${RESET}"; NEED_REFRESH=1
               fi ;;
            5) echo -n "Enter Latency Threshold (ms, e.g. 50): "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[0-9]+$ ]]; then
                   sed -i "s/^TRIGGER_LATENCY=.*/TRIGGER_LATENCY=$NEW_VAL/" "$P"
                   echo -e " -> ${GREEN}Updated.${RESET}"; NEED_REFRESH=1
               fi ;;
            6) echo -n "Enter DB Retention (1-3650 days; lowering removes older samples on the next run): "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[0-9]+$ ]] && [ "$NEW_VAL" -ge 1 ] && [ "$NEW_VAL" -le 3650 ]; then
                   if grep -q '^RETENTION_DAYS=' "$P";then sed -i "s/^RETENTION_DAYS=.*/RETENTION_DAYS=$NEW_VAL/" "$P";else printf '\nRETENTION_DAYS=%s\n' "$NEW_VAL" >> "$P";fi
                   echo -e " -> ${GREEN}Updated.${RESET}"; NEED_REFRESH=1
               else echo 'Retention must be between 1 and 3650 days.';fi ;;
            7) 
               if [ "$CUR_ALERTS" = "true" ]; then NEW_VAL="false"; else NEW_VAL="true"; fi
               if grep -q "EMAIL_ALERTS=" "$P"; then
                   sed -i 's/^EMAIL_ALERTS=".*"/EMAIL_ALERTS="'$NEW_VAL'"/' "$P"
               else
                   sed -i '/^ENABLE_IPV6=/a EMAIL_ALERTS="'$NEW_VAL'"' "$P"
               fi
               echo -e " -> Email Alerts: $NEW_VAL"
    
               ;;
            8) echo -n "Enter maximum chart points (100-10000; default 2000): "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[0-9]+$ ]] && [ "$NEW_VAL" -ge 100 ] && [ "$NEW_VAL" -le 10000 ];then
                   local points_tmp
                   points_tmp=$(mktemp "$P.XXXXXX") || return 1
                   if awk '!/^MAX_DISPLAY_POINTS=/' "$P" > "$points_tmp" && printf '\nMAX_DISPLAY_POINTS=%s\n' "$NEW_VAL" >> "$points_tmp" && chmod 600 "$points_tmp" && mv "$points_tmp" "$P";then
                       echo 'Chart point limit updated; original samples are unchanged.'; NEED_REFRESH=1
                   else rm -f "$points_tmp";echo 'Could not save the chart point limit.';fi
               else echo 'Chart point limit must be between 100 and 10000.';fi ;;
            9) echo -n "Enter WAN notification label (e.g. ppp0; empty = automatic route interface): "; read -r NEW_VAL
               if [ -z "$NEW_VAL" ] || [[ "$NEW_VAL" =~ ^[a-zA-Z0-9_.:-]+$ ]];then
                   local wan_tmp
                   wan_tmp=$(mktemp "$P.XXXXXX") || return 1
                   if awk '!/^WAN_LABEL=/' "$P" > "$wan_tmp" && printf '\nWAN_LABEL="%s"\n' "$NEW_VAL" >> "$wan_tmp" && chmod 600 "$wan_tmp" && mv "$wan_tmp" "$P";then
                       echo 'Notification label updated. Probe routing is unchanged.'
                   else rm -f "$wan_tmp";echo 'Could not save the WAN label.';fi
               else echo 'Use letters, digits, underscores, dots, colons or hyphens.';fi ;;
            10) echo -n "Enter PPP syslog polling interval (1-60 seconds; default 5): "; read -r NEW_VAL
               if [[ "$NEW_VAL" =~ ^[0-9]+$ ]] && [ "$NEW_VAL" -ge 1 ] && [ "$NEW_VAL" -le 60 ];then
                   local interval_tmp
                   interval_tmp=$(mktemp "$P.XXXXXX") || return 1
                   if awk '!/^WAN_MONITOR_INTERVAL=/' "$P" > "$interval_tmp" && printf '\nWAN_MONITOR_INTERVAL=%s\n' "$NEW_VAL" >> "$interval_tmp" && chmod 600 "$interval_tmp" && mv "$interval_tmp" "$P";then
                       echo 'PPP monitor interval updated; ping schedule is unchanged.'
                   else rm -f "$interval_tmp";echo 'Could not save the PPP interval.';fi
               else echo 'PPP interval must be between 1 and 60 seconds.';fi ;;
            0) 
               if [ $NEED_REFRESH -eq 1 ]; then
                   echo ""
                   echo -e "${YELLOW}You made changes.${RESET}"
                   echo -n " -> Run Pingtool now to update Dashboard data? (Takes ~${CUR_DUR}s) (y/n): "
                   read -r refresh
   
                  if [ "$refresh" = "y" ] || [ "$refresh" = "Y" ]; then
                       echo "Running Pingtool... Please wait..."
                       run_protected /opt/bin/pingtool.sh
                       echo -e "${GREEN}Done. Dashboard updated.${RESET}"
                 
                       sleep 1
                   fi
               fi
               return ;;
        esac
        sleep 1
    done
}

# --- SELF UPDATE (INTERACTIVE) ---
action_self_update() {
    if [ "${KT_MANAGED_PACKAGE:-false}" = true ]; then /opt/bin/bash /opt/bin/keentool_update; return 0; fi
    header; echo -e "${BOLD}Checking Keentool status...${RESET}"
    IFS='|' read -r N P R F <<EOF
$T_SELF
EOF
    TMP_FILE="/tmp/keentool.tmp"
    echo -n " -> Contacting GitHub ($R)... "; curl -fsSL --connect-timeout 10 --max-time 60 --retry 1 "$BASE_URL/$R/main/$F" -o "$TMP_FILE"
    
    if [ ! -s "$TMP_FILE" ]; then 
        echo -e "${RED}Failed.${RESET}"; rm -f "$TMP_FILE"; pause; return
    fi
    
    sed -i 's/\r$//' "$TMP_FILE"
    L_VER=$(get_version "$P"); R_VER=$(get_version "$TMP_FILE"); ver_compare "$R_VER" "$L_VER"; RES=$?
    
    echo -e " ${GREEN}OK${RESET}"; echo ""
    if [ $RES -eq 1 ]; then
        echo -e "${MAGENTA}Update: v$L_VER -> v$R_VER${RESET}"
        echo -n " -> Apply & Restart? (y/n): "; read -r ans
        if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then 
            kt_validate "$TMP_FILE" || return 1; cp -p "$P" "${P}.previous" || return 1; mv "$TMP_FILE" "$P"; apply_perms "$P"
            # Remove flag if exists
            rm -f "/tmp/keentool_new_ver"
            send_analytics "update"
            echo -e "${GREEN}Updated.${RESET}"; sleep 1; exec "$P"
        else rm -f "$TMP_FILE"; pause; fi
    elif [ $RES -eq 2 ]; then
        echo -e "${YELLOW}Local is Newer (Dev).${RESET}"; rm -f "$TMP_FILE"; pause
    else
        if [ "$(get_md5 "$P")" != "$(get_md5 "$TMP_FILE")" ]; then
            echo -e "${CYAN}MD5 Differs.${RESET}"
            echo -n " -> Force Reinstall? (y/n): "; read -r ans
            if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then 
                kt_validate "$TMP_FILE" || return 1; cp -p "$P" "${P}.previous" || return 1; mv "$TMP_FILE" "$P"; apply_perms "$P"
                echo "Reinstalling..."; sleep 1; exec "$P"
            else rm -f "$TMP_FILE"; pause; fi
        else echo -e "${GREEN}Up to date.${RESET}"; rm -f "$TMP_FILE"; pause; fi
    fi
}

