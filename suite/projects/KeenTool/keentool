configure_logging_modules() {
    if [ "${KT_MANAGED_PACKAGE:-false}" = true ]; then echo 'Syslog-ng is administrator-managed; review docs/INSTALL.md for logging integration'; pause; return; fi
    # Defaults
    EN_VPN="yes"; EN_SCRIPTS="yes"; EN_DNS="yes"; EN_WIFI="yes"; EN_DHCP="yes"; EN_PROXY="yes"; EN_ULOGD="no"
    
    CONF="/opt/etc/syslog-ng.conf"
    DASH_CONF="/opt/etc/keentool/dashboard.conf"
    
    # State Detection (Priority: Dashboard Conf > Syslog Conf)
    if [ -f "$DASH_CONF" ]; then
        # New Method: Read from state file (Decoupled)
        . "$DASH_CONF"
    elif [ -f "$CONF" ]; then
        # Legacy Method: Guess from Syslog-ng
        grep -q "filter(f_vpn); destination(d_vpn);" "$CONF" || EN_VPN="no"
        grep -q "filter(f_scripts); destination(d_scripts);" "$CONF" || EN_SCRIPTS="no"
        grep -q "filter(f_dns); destination(d_dns);" "$CONF" || EN_DNS="no"
        grep -q "filter(f_wifi); destination(d_wifi);" "$CONF" || EN_WIFI="no"
        grep -q "filter(f_dhcp); destination(d_dhcp);" "$CONF" || EN_DHCP="no"
        grep -q "filter(f_proxy); destination(d_proxy);" "$CONF" || EN_PROXY="no"
        grep -q "# ulogd_enabled" "$CONF" && EN_ULOGD="yes"
    fi
    # Auto-enable ULOGD if the log file exists and it is the first setup
    if [ ! -f "$CONF" ] && [ -f "/opt/var/log/ulogd.log" ]; then EN_ULOGD="yes"; fi

    # Helper function for Symlinks (used in both 'a' and 'h' options)
    sync_symlinks() {
        mkdir -p "$WEB_ROOT"
        LOG_LIST="vpn keentool dns_proxy wifi_monitor ndhcps nginx_proxy ulogd"
        for L in $LOG_LIST; do
            # Create empty file if it doesn't exist (prevents broken link errors)
            if [ ! -f "/opt/var/log/${L}.log" ]; then touch "/opt/var/log/${L}.log"; fi
            chmod 644 "/opt/var/log/${L}.log"
            # Create the link if missing
            if [ ! -L "$WEB_ROOT/${L}.log" ]; then ln -sf "/opt/var/log/${L}.log" "$WEB_ROOT/${L}.log"; fi
        done
        # Main syslog
        if [ ! -L "$WEB_ROOT/messages.log" ]; then ln -sf /opt/var/log/messages "$WEB_ROOT/messages.log"; fi
    }

    while true; do
        header; echo -e "${BOLD}Modular Logging Configuration${RESET}"
        if [ "$EN_VPN" = "yes" ]; then c_vpn="${GREEN}ON${RESET}"; else c_vpn="${RED}OFF${RESET}"; fi
        if [ "$EN_SCRIPTS" = "yes" ]; then c_scr="${GREEN}ON${RESET}"; else c_scr="${RED}OFF${RESET}"; fi
        if [ "$EN_DNS" = "yes" ]; then c_dns="${GREEN}ON${RESET}"; else c_dns="${RED}OFF${RESET}"; fi
        if [ "$EN_WIFI" = "yes" ]; then c_wif="${GREEN}ON${RESET}"; else c_wif="${RED}OFF${RESET}"; fi
        if [ "$EN_DHCP" = "yes" ]; then c_dhc="${GREEN}ON${RESET}"; else c_dhc="${RED}OFF${RESET}"; fi
        if [ "$EN_PROXY" = "yes" ]; then c_prx="${GREEN}ON${RESET}"; else c_prx="${RED}OFF${RESET}"; fi
        if [ "$EN_ULOGD" = "yes" ]; then c_ulo="${GREEN}ON${RESET}"; else c_ulo="${RED}OFF${RESET}"; fi
        
        echo -e " 1. VPN Events (OpenVPN/WireGuard)    [$c_vpn]"
