# --- GLOBAL SCAN ---
perform_global_scan() {
    if [ "${KT_MANAGED_PACKAGE:-false}" = true ]; then /opt/bin/bash /opt/bin/keentool_update; return 0; fi
    echo -e "${BOLD}Checking for updates...${RESET}"
    check_tool_status() {
        local VNAME=$1; local LPATH=$2; local REPO=$3; local RFILE=$4
        echo -n "."
        if [ -f "$LPATH" ]; then
            local L_VER=$(get_version "$LPATH"); local TMP="/tmp/check_${RFILE##*/}.tmp"
