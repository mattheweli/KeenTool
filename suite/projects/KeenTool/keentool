        echo -e "Firewall Suite Status: $S_MAIN"; echo ""; echo " 1. Install / Update"; echo " 2. Manage Cron"; echo " 3. Run Manager"; echo " 4. Run Monitor"; echo " 5. Uninstall Suite"; echo " 6. History aggregation settings"; echo ""; echo " 0. Back"; echo ""; echo -n "Select: "; read -r op
