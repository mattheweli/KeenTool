#!/opt/bin/bash
# KeenTool Backup Manager v1.0.1
set -u
export PATH=/opt/bin:/opt/sbin:/opt/usr/bin:/opt/usr/sbin:/usr/bin:/usr/sbin:/bin:/sbin
umask 077
shopt -s dotglob nullglob
entries=()
root=${KT_BACKUP_ROOT:-}
base=$root/opt/var/backups
state=$root/opt/etc/keentool
policy=$state/backup-retention-days
install_lock=$root/opt/tmp/keentool-install.lockdir
entware_lock=$root/tmp/keentool-entware.lockdir
groups=(entware release db web alpha test history-config)
now=$(date +%s) || exit 1

valid_days() { [[ "$1" =~ ^[1-9][0-9]{0,3}$ ]] && [ "$1" -le 3650 ]; }
retention() {
 local n=''
 [ ! -L "$policy" ] && [ -f "$policy" ] && IFS= read -r n < "$policy" && valid_days "$n" || n=0
 printf '%s\n' "$n"
}
set_retention() {
 local n=$1 tmp
 { [ "$n" = 0 ] || valid_days "$n"; } || { echo 'Enter 0 (off), or 1 to 3650 days.' >&2;return 1; }
 take_locks || { echo 'Policy change deferred: maintenance or recovery is active.' >&2;return 75; }
 mkdir -p "$state" || return 1
 tmp=$(mktemp "$state/.backup-retention.XXXXXX") || return 1
 if ! { printf '%s\n' "$n" > "$tmp" && mv -f "$tmp" "$policy"; };then rm -f "$tmp";return 1;fi
 if [ "$n" = 0 ];then echo 'Automatic purge disabled.';else echo "Retention: $n days. Set or check the schedule in KeenTool.";fi
}
group_path() {
 local g=$1 opt physical
 opt=$(readlink -f "$root/opt") || return 1
 physical=$(readlink -f "$base/keentool-$g") || return 1
 [[ "$physical" =~ ^/[a-zA-Z0-9_./-]+$ ]] || return 1
 [ "$physical" = "$opt/var/backups/keentool-$g" ] && [ -d "$physical" ] || return 1
 printf '%s\n' "$physical"
}
timestamp() {
 local n;n=$(date -r "$1" +%s 2>/dev/null) || return 1
 [[ "$n" =~ ^[0-9]{1,12}$ ]] && [ "$n" -le "$now" ] || return 1
 printf '%s\n' "$n"
}
candidate_name() {
 case "$1" in
  entware) [[ "$2" =~ ^[0-9]{8}_[0-9]{6}-[0-9]+$ ]];;
  release) [[ "$2" =~ ^[0-9]{8}_[0-9]{6}-[0-9]+-[a-f0-9]{6}$ ]];;
  *) return 1;;
 esac
}
recognized_backup() {
 local g=$1 p=$2
 candidate_name "$g" "${p##*/}" && [ -d "$p" ] && [ ! -L "$p" ] || return 1
 case "$g" in
  entware)
   [ -f "$p/worker-exit-code" ] && [ ! -L "$p/worker-exit-code" ] &&
    [ -f "$p/status" ] && [ ! -L "$p/status" ] &&
    [ "$(cat "$p/worker-exit-code")" = 0 ] && [ "$(cat "$p/status")" = completed ];;
  release)
   [ -s "$p/transaction.json" ] && [ ! -L "$p/transaction.json" ] &&
    [ -s "$p/rollback.sh" ] && [ ! -L "$p/rollback.sh" ];;
 esac
}
newest() {
 local dir=$1 g=$2 p n t best='' high=-1
 for p in "$dir"/*;do
  n=${p##*/};recognized_backup "$g" "$p" || continue
  t=$(timestamp "$p") || continue
  if (( t >= high ));then best=$n;high=$t;fi
 done
 printf '%s\n' "$best"
}
protected_reason() {
 local g=$1 p=$2 keep=$3 latest='' name=${2##*/}
 candidate_name "$g" "$name" || { echo 'Inventory only';return; }
 [ "$name" != "$keep" ] && [ -n "$keep" ] || { echo 'Newest backup';return; }
 if ! recognized_backup "$g" "$p";then echo 'Incomplete or unrecognized backup';return;fi
 if [ "$g" = entware ] && { [ -e "$state/entware/latest-run" ] || [ -L "$state/entware/latest-run" ]; };then
  [ ! -L "$state/entware/latest-run" ] &&
   IFS= read -r latest < "$state/entware/latest-run" &&
   [[ "$latest" = /* ]] || { echo 'Invalid latest-run record';return; }
  [ "${latest##*/}" != "$name" ] || { echo 'Latest Entware run';return; }
 fi
}
manual_protection() {
 local g=$1 p=$2 ref marker
 case "$g" in
  web) marker=$state/security/web-hardened;;
  entware) marker=$state/entware/latest-run;;
  *) return 0;;
 esac
 if [ -e "$marker" ] || [ -L "$marker" ];then
  [ ! -L "$marker" ] && [ -f "$marker" ] &&
    IFS= read -r ref < "$marker" && [[ "$ref" = /* ]] ||
    { echo 'Invalid recovery reference';return; }
  if [ "${ref##*/}" = "${p##*/}" ];then
   if [ "$g" = web ];then echo 'Active web rollback copy'
   elif ! recognized_backup "$g" "$p";then echo 'Latest Entware run still needs recovery review';fi
  fi
 fi
}
list_backups() {
 local g dir p t keep reason size days label manual selected=${1:-0} limit=${2:-0}
 entries=()
 printf '%4s  %-48s %8s %10s  %s\n' 'ID' 'Backup (group/name)' 'Age' 'Size KiB' 'Status'
 for g in "${groups[@]}";do
  dir=$(group_path "$g") || continue
  keep=$(newest "$dir" "$g")
  for p in "$dir"/*;do
   [ ! -L "$p" ] && { [ -d "$p" ] || [ -f "$p" ]; } || continue
   t=$(timestamp "$p") || t=''
   days=?;[ -z "$t" ] || days=$(( (now-t)/86400 ))
   reason=$(protected_reason "$g" "$p" "$keep")
   if [ "$selected" = 1 ];then
    [ "$limit" -gt 0 ] && [ "$days" != '?' ] && [ "$days" -ge "$limit" ] && [ -z "$reason" ] || continue
   fi
   manual=$(manual_protection "$g" "$p")
   if [ -n "$manual" ];then reason=$manual
   elif [ -n "$reason" ];then reason="$reason (manual only)"
   else reason='Eligible';fi
   entries+=("$g/${p##*/}")
   printf -v label '%q' "$g/${p##*/}"
   size=$(du -sk "$p" 2>/dev/null) || size='?'
   printf '%4d  %-48s %6s d %10s  %s\n' "${#entries[@]}" "$label" "$days" "${size%%[[:space:]]*}" "$reason"
  done
 done
}
take_locks() {
 mkdir "$install_lock" 2>/dev/null || return 1
 trap 'rmdir "$install_lock" 2>/dev/null || :' EXIT
 mkdir "$entware_lock" 2>/dev/null || return 1
 trap 'rm -f "$entware_lock/pid";rmdir "$entware_lock" "$install_lock" 2>/dev/null || :' EXIT
 trap 'exit 1' INT TERM HUP
 printf '%s\n' "$$" > "$entware_lock/pid" || return 1
 local n
 for n in maintenance firewall-upgrade.pending security/pending.json;do
  [ ! -e "$state/$n" ] && [ ! -L "$state/$n" ] || return 1
 done
}
remove_backup() {
 local g=$1 n=$2 mode=$3 min_days=${4:-0} dir p t reason escaped ref latest=$state/entware/latest-run
 # A manual entry is an immediate child of a fixed backup root.
 [[ -n "$n" && "$n" != */* && "$n" != . && "$n" != .. ]] || return 1
 dir=$(group_path "$g") || return 1
 p=$dir/$n
 [ ! -L "$p" ] && { [ -f "$p" ] || [ -d "$p" ]; } &&
   [ "$(readlink -f "$p")" = "$p" ] || return 1
 if [ "$mode" = auto ];then
  t=$(timestamp "$p") || return 1
  (( (now-t)/86400 >= min_days )) || return 1
  reason=$(protected_reason "$g" "$p" "$(newest "$dir" "$g")")
 else
  reason=$(manual_protection "$g" "$p")
 fi
 [ -z "$reason" ] || { printf 'Kept %q: %s\n' "$g/$n" "$reason" >&2;return 1; }
 # Mountinfo escapes path separators in its whitespace-delimited fields.
 escaped=${p//\\/\\134}
 escaped=${escaped// /\\040}
 escaped=${escaped//$'\t'/\\011}
 escaped=${escaped//$'\n'/\\012}
 if ! KT_MOUNT_PATH="$escaped" awk 'BEGIN{p=ENVIRON["KT_MOUNT_PATH"]} NF>=10{ok=1} $5==p || index($5,p "/")==1{exit 1} END{if(!ok)exit 1}' /proc/self/mountinfo;then
  printf 'Cannot verify a mount-free backup: %q\n' "$g/$n" >&2;return 1
 fi
 rm -rf -- "$p" || return 1
 # Do not leave the status menu pointing to a deleted completed run.
 if [ "$mode" = manual ] && [ "$g" = entware ] && [ -f "$latest" ] && [ ! -L "$latest" ] &&
    IFS= read -r ref < "$latest" && [ "${ref##*/}" = "$n" ];then
  rm -f -- "$latest" || return 1
 fi
 printf 'Deleted %q\n' "$g/$n"
}
auto_purge() {
 local limit=$1 g dir p keep reason t bad=0
 [ "$limit" -gt 0 ] || return 0
 take_locks || { echo 'Backup purge deferred: maintenance or recovery is active.' >&2;return 75; }
 limit=$(retention)
 [ "$limit" -gt 0 ] || return 0
 for g in entware release;do
  dir=$(group_path "$g") || continue
  keep=$(newest "$dir" "$g")
  for p in "$dir"/*;do
   [ -d "$p" ] && [ ! -L "$p" ] || continue
   t=$(timestamp "$p") || continue
   (( (now-t)/86400 >= limit )) || continue
   reason=$(protected_reason "$g" "$p" "$keep")
   [ -z "$reason" ] || continue
   remove_backup "$g" "${p##*/}" auto "$limit" || bad=1
  done
 done
 return "$bad"
}
manual_delete() {
 local mode=$1 id key answer bad=0
 [ -t 0 ] || { echo 'Manual deletion requires an interactive terminal.' >&2;return 1; }
 list_backups
 [ "${#entries[@]}" -gt 0 ] || { echo 'No backups found.';return 0; }
 if [ "$mode" = one ];then
  printf 'Backup ID (0 to cancel): '
  IFS= read -r id || return 0
  [ "$id" != 0 ] || return 0
  [[ "$id" =~ ^[1-9][0-9]{0,8}$ ]] && (( id <= ${#entries[@]} )) ||
   { echo 'Invalid backup ID.' >&2;return 1; }
  key=${entries[id-1]}
  entries=("$key")
  printf 'Permanently delete %q? Type DELETE to confirm: ' "$key"
  answer=DELETE
 else
  echo 'This deletes every displayed backup that is not needed for active recovery, including the newest and incomplete copies.'
  printf 'Type DELETE ALL to confirm: '
  answer='DELETE ALL'
 fi
 local typed
 IFS= read -r typed && [ "$typed" = "$answer" ] || { echo 'Canceled.';return 0; }
 take_locks || { echo 'Backup deletion deferred: maintenance or recovery is active.' >&2;return 75; }
 for key in "${entries[@]}";do
  remove_backup "${key%%/*}" "${key#*/}" manual || bad=1
 done
 [ "$bad" = 0 ] || echo 'Some backups were kept; see the messages above.' >&2
 return "$bad"
}
case "${1:---list}" in
 --list) list_backups;;
 --preview) list_backups 1 "$(retention)";;
 --retention) retention;;
 --set-retention) set_retention "${2:-}";;
 --delete) [ "$#" = 1 ] && manual_delete one;;
 --delete-all) [ "$#" = 1 ] && manual_delete all;;
 --auto) auto_purge "$(retention)";;
 *) echo 'Usage: backup_manager --list | --preview | --retention | --set-retention DAYS | --delete | --delete-all | --auto' >&2;exit 2;;
esac
