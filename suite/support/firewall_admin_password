#!/opt/bin/bash
# FIREWALL ADMIN PASSWORD v1.0.1 — 2026-10-28
# Changelog: prompt after migration when unconfigured; preserve existing credentials;
# support legacy background updater terminals and retry invalid confirmation.
# Passwords are read silently and passed to the local setter on stdin only.
set -Eeuo pipefail
export PATH="${KT_INSTALL_ROOT:-}/opt/bin:/opt/bin:/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=C
[ "$(id -u)" = 0 ] || { echo 'Run as root' >&2; exit 1; }
setup=false
case "${1:-}" in
    '') [ "$#" = 0 ] || exit 2 ;;
    --setup-if-missing) [ "$#" = 1 ] || exit 2;setup=true ;;
    *) echo 'Usage: firewall_admin_password [--setup-if-missing]' >&2;exit 2 ;;
esac
find_php_cli() {
    local candidate
    for candidate in "${KT_PHP_CLI:-}" "${KT_INSTALL_ROOT:-}/opt/bin/php-cli" /opt/bin/php-cli /opt/bin/php8 /opt/bin/php; do
        if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" -r 'exit(PHP_SAPI === "cli" ? 0 : 1);' >/dev/null 2>&1; then
            printf '%s\n' "$candidate"; return 0
        fi
    done
    return 1
}
PHP_CLI=$(find_php_cli) || { echo 'PHP CLI executable not found (tried php-cli, php8, php). Run: opkg files php8-cli' >&2; exit 1; }
admin_file="${KT_INSTALL_ROOT:-}/opt/etc/keentool/admin/credentials.json"
if [ "$setup" = true ] && { [ -e "$admin_file" ] || [ -L "$admin_file" ]; };then
    if [ ! -L "$admin_file" ] && "$PHP_CLI" -r '$c=json_decode((string)@file_get_contents($argv[1]),true);exit(is_array($c)&&is_string($c["hash"]??null)&&!empty(password_get_info($c["hash"])["algo"])&&is_string($c["revision"]??null)&&$c["revision"]!==""?0:1);' "$admin_file";then
        echo 'Admin password already configured; existing credentials preserved.'
        exit 0
    fi
    echo 'Existing admin credential file needs review; it has not been replaced.' >&2
    echo 'Reset it explicitly from KeenTool option A or firewall_admin_password.' >&2
    exit 1
fi
input_fd=0;tty_open=false
if [ -t 0 ];then :
elif [ -t 2 ] && { exec {input_fd}</dev/tty; } 2>/dev/null;then tty_open=true
else
    echo 'Admin password setup requires an interactive SSH terminal.' >&2
    echo 'Run KeenTool option A or /opt/bin/bash /opt/bin/firewall_admin_password.' >&2
    [ "$setup" = true ] && exit 0
    exit 1
fi
cleanup(){ unset kt_admin_password kt_admin_repeat;[ "$tty_open" != true ] || exec {input_fd}<&-; }
trap cleanup EXIT
if [ "$setup" = true ];then
    printf '\n%s\n%s\n' 'Web administrator setup' 'Set a dedicated web admin password. No router username or password is changed.' >&2
fi
while true;do
    if ! IFS= read -rs -u "$input_fd" -p 'Admin password (12-72 bytes): ' kt_admin_password;then echo >&2;echo 'Admin password setup not completed.' >&2;exit 1;fi
    echo >&2
    if ! IFS= read -rs -u "$input_fd" -p 'Repeat password: ' kt_admin_repeat;then echo >&2;echo 'Admin password setup not completed.' >&2;exit 1;fi
    echo >&2
    if [ "$kt_admin_password" != "$kt_admin_repeat" ];then echo 'Passwords differ; try again.' >&2;unset kt_admin_password kt_admin_repeat;continue;fi
    if [ "${#kt_admin_password}" -lt 12 ] || [ "${#kt_admin_password}" -gt 72 ];then echo 'Password must contain 12-72 bytes; try again.' >&2;unset kt_admin_password kt_admin_repeat;continue;fi
    args=();[ "$setup" != true ] || args=(--if-missing)
    printf '%s' "$kt_admin_password" | "$PHP_CLI" "${KT_INSTALL_ROOT:-}/opt/lib/keentool-admin/set_password.php" "${args[@]}"
    break
done
