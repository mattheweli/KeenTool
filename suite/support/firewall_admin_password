#!/opt/bin/bash
# FIREWALL ADMIN PASSWORD v1.0.0 — 2026-10-22
# Changelog: a2: discover the actual PHP CLI executable; a1: hidden interactive password input and confirmation.
# Set/reset admin password interactively; no password on command line or disk.
set -e
export PATH=/opt/bin:/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin
[ "$(id -u)" = 0 ] || { echo 'Run as root'; exit 1; }
find_php_cli() {
    local candidate
    for candidate in "${KT_PHP_CLI:-}" /opt/bin/php-cli /opt/bin/php8 /opt/bin/php; do
        if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" -r 'exit(PHP_SAPI === "cli" ? 0 : 1);' >/dev/null 2>&1; then
            printf '%s\n' "$candidate"; return 0
        fi
    done
    return 1
}
PHP_CLI=$(find_php_cli) || { echo 'PHP CLI executable not found (tried php-cli, php8, php). Run: opkg files php8-cli' >&2; exit 1; }
[ -t 0 ] || { echo 'Use an interactive SSH terminal'; exit 1; }
read -rs -p 'Admin password (12–72 ASCII characters): ' kt_admin_password; echo
read -rs -p 'Repeat password: ' kt_admin_repeat; echo
[ "$kt_admin_password" = "$kt_admin_repeat" ] || { echo 'Passwords differ'; exit 1; }
printf '%s' "$kt_admin_password" | "$PHP_CLI" /opt/lib/keentool-admin/set_password.php
unset kt_admin_password kt_admin_repeat
